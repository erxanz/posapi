# ================= CLOUDFLARE TUNNEL CONFIGURATION =================
# Gunakan file .env ini sebagai template ketika deploy menggunakan Cloudflare Tunnel
# Ganti domain di bawah dengan actual domain Cloudflare Tunnel Anda
# Contoh: posapi-tunnel.example.com

# Copy dari .env, kemudian ubah nilai-nilai di bawah:

APP_URL=https://posapi-tunnel.example.com
FRONTEND_URL=https://posapi-tunnel.example.com:8000

# ================= BROADCAST REALTIME (REVERB) =================
# Untuk Cloudflare Tunnel, gunakan domain tunnel dan HTTPS
REVERB_HOST=posapi-tunnel.example.com
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_HOST=${REVERB_HOST}
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# ================= SANCTUM STATEFUL DOMAINS =================
# Tambahkan domain Cloudflare Tunnel ke whitelist untuk cookie-based auth
SANCTUM_STATEFUL_DOMAINS=localhost,posapi-tunnel.example.com

# ================= PAKAI NILAI INI DARI .env LOCAL =================
# Copy paste nilai-nilai berikut dari .env lokal Anda:
# - APP_KEY
# - APP_DEBUG
# - DB_* (database credentials)
# - REDIS_*
# - MAIL_*
# - MIDTRANS_*
# - REVERB_APP_ID, REVERB_APP_KEY, REVERB_APP_SECRET
# - Dll
